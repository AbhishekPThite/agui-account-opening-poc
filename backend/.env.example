# Internal OpenAI-compatible model endpoint
LLM_ENABLED=true
OPENAI_BASE_URL=https://103.42.50.41:1034/v1
OPENAI_MODEL=Qwen/Qwen3-8B
OPENAI_API_KEY=

# TLS verification stays enabled. Set the CA certificate path supplied by your organization.
# Example: INTERNAL_CA_CERT=/Users/<you>/Downloads/vm04-ca.crt
INTERNAL_CA_CERT=

LLM_TIMEOUT_SECONDS=120
LLM_TEMPERATURE=0
LLM_MAX_RETRIES=2

# LangGraph checkpoint storage
# Use "memory" for the original local-only behaviour or "postgres" for durable state.
CHECKPOINTER_BACKEND=memory
DATABASE_URL=postgresql://agui_poc:agui_poc_dev_only@localhost:5432/agui_poc
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=10

# Restrict checkpoint deserialization to safe msgpack types.
LANGGRAPH_STRICT_MSGPACK=true

# Java Spring Boot Client and Draft Application Experience APIs (hypothetical contract)
# Mock mode exercises both profile lookup and draft creation locally. HTTP mode calls both Java endpoints.
JAVA_API_MODE=mock
JAVA_API_BASE_URL=http://localhost:8081
JAVA_API_BEARER_TOKEN=
JAVA_API_TIMEOUT_SECONDS=15
# Optional internal CA certificate path; TLS verification remains enabled.
JAVA_API_CA_CERT=
